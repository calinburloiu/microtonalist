# Grades the finished trials of an eval run with skillgrade, which writes its report under <out>/skillgrade.
#
# Usage: bin/grade OUT_DIR [skillgrade flags...]   e.g. bin/grade "$OUT" --eval=draft-notes
set -euo pipefail
EVAL_DIR=$(cd "$(dirname "$0")/.." && pwd)
OUT=$(cd "${1:?usage: bin/grade OUT_DIR [skillgrade flags...]}" && pwd)
shift

find "$OUT/trials" -name .imported -type d -prune -exec rm -rf {} +
trials=$(find "$OUT/trials" -mindepth 2 -maxdepth 2 -type d | awk -F/ '{print $(NF-1)}' | sort | uniq -c \
  | awk 'NR == 1 || $1 < min {min = $1} END {print min}')

cd "$EVAL_DIR"
TRIALS_DIR="$OUT/trials" npx -y skillgrade@0.3.0 --provider=local --parallel=1 --trials="$trials" \
  --output="$OUT/skillgrade" "$@"
