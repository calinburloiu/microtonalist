"""Extracts what the graders need from the transcript of the subagent that ran a trial: its final message and
hand-back report (`agent-output.txt`) and the Bash commands it ran (`commands.txt`), both written into the trial
directory.

Usage: bin/collect-trial TRIAL_DIR TRANSCRIPT_JSONL
"""

import json
import sys


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    trial, transcript = sys.argv[1], sys.argv[2]
    final, handback, commands = "", "", []
    with open(transcript) as f:
        for line in f:
            entry = json.loads(line)
            if entry.get("type") != "assistant":
                continue
            content = entry.get("message", {}).get("content", [])
            if not isinstance(content, list):
                continue
            texts = [block["text"] for block in content if block.get("type") == "text" and block["text"].strip()]
            if texts:
                final = "\n".join(texts)
            for block in content:
                if block.get("type") != "tool_use":
                    continue
                if block.get("name") == "Bash":
                    commands.append(block["input"].get("command", ""))
                elif block.get("name") == "SubagentHandback":
                    handback = block["input"].get("message", "")
    # A subagent may end with a text message, a hand-back report, or both: keep both.
    output = "\n\n".join(part.strip() for part in (final, handback) if part.strip())
    with open(f"{trial}/agent-output.txt", "w") as f:
        f.write(output + "\n")
    with open(f"{trial}/commands.txt", "w") as f:
        f.write("".join(f"$ {c}\n" for c in commands))
    print(f"{trial}: {len(output)} chars of final message, {len(commands)} Bash commands")


if __name__ == "__main__":
    main()
