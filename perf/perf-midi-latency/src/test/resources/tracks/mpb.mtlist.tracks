{
  "tracks": [
    {
      "id": "perf",
      "name": "Latency suite",
      "input": {
        "midiDeviceId": { "name": "{{input.name}}", "vendor": "{{input.vendor}}" }
      },
      "tuningChangers": ["pedal"],
      "tuner": { "type": "monophonicPitchBend" },
      "output": {
        "midiDeviceId": { "name": "{{output.name}}", "vendor": "{{output.vendor}}" }
      }
    }
  ]
}
