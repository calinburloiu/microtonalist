#
# mtlist-coverage-modules — measure the coverage of the given modules with their own tests only.
#
# Runs sbt's `coverageModules` command (see docs/development/coverage.md) in a fresh sbt JVM that builds into
# `<project>/target-scoverage/`, so that it doesn't race the development stack's sbt (`target-bsp/`) or an IDE
# (`target/`) on the same classes. Coverage commands don't work through `sbtn`.
#

set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <module> [<module> ...]" >&2
  echo "Measures the coverage of the given sbt modules (e.g. tuner, sc-midi) with their own tests only." >&2
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi
case "$1" in
  -h|--help) usage; exit 0 ;;
esac

cd "$(dirname "${BASH_SOURCE[0]}")/.."
exec sbt -Dmicrotonalist.build.targetSuffix=-scoverage "coverageModules $*"
