#
# mtlist-qa-mcp — run the GUI QA MCP server, which Claude Code starts over stdio.
#
# Runs the JARs that `sbtn assembly` builds into the BSP server's `target-bsp/` directories. The app under test is
# `app/app/.../microtonalist-app.jar`, unless MTLIST_QA_APP_JAR names another JAR. `exec` makes the JVM the process
# that Claude Code started, so that its stop signals reach it.
#

set -euo pipefail

SCRIPT_PATH="$( cd "$( dirname "$(readlink -f "${BASH_SOURCE[0]}")" )" && pwd )"
# The Scala version is part of the JARs' paths; build.sbt reads it from the same file.
SCALA_VERSION="$(< "${SCRIPT_PATH}/../project/scala-version")"
TARGET="target-bsp/scala-${SCALA_VERSION}"

SERVER_JAR="${SCRIPT_PATH}/../testbench/qa-mcp/${TARGET}/microtonalist-qa-mcp.jar"
APP_JAR="${MTLIST_QA_APP_JAR:-${SCRIPT_PATH}/../app/app/${TARGET}/microtonalist-app.jar}"
DRIVER_JAR="${SCRIPT_PATH}/../testbench/qa-driver/${TARGET}/microtonalist-qa-driver.jar"

for jar in "$SERVER_JAR" "$APP_JAR" "$DRIVER_JAR"; do
  if [[ ! -f "$jar" ]]; then
    echo "mtlist-qa-mcp: ${jar} not found; run sbtn assembly" >&2
    exit 1
  fi
done

exec java -jar "$SERVER_JAR" --app-jar "$APP_JAR" --driver-jar "$DRIVER_JAR"
